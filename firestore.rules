rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Master data cửa hàng (Region/City/AM) và target doanh thu: người đã đăng nhập
    // được sửa trên web. Đặt TRƯỚC rule chặn ghi bên dưới vì Firestore rules khớp
    // theo match cụ thể nhất, không "cộng dồn" các match trùng đường dẫn.
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /targets/{targetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Danh sách AM / Thành phố quản lý ở tab Chi nhánh (config/lists)
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Phần còn lại (d05Daily, d05Days, syncState...): chỉ đọc, không ai ghi từ
    // trình duyệt - dữ liệu chỉ được ghi bởi script RPA dùng Admin SDK (service
    // account), luôn bỏ qua rules này.
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
