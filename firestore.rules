rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Master data cửa hàng (Region/City/AM) và target doanh thu: người đã đăng nhập
    // được sửa trên web. Đặt TRƯỚC rule chặn ghi bên dưới vì Firestore rules khớp
    // theo match cụ thể nhất, không "cộng dồn" các match trùng đường dẫn.
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /targets/{targetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Danh sách AM / Thành phố quản lý ở tab Chi nhánh (config/lists)
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Nút "Nạp bù bằng file D05" ở tab Data ghi đúng các collection mà script đồng bộ
    // ghi (cùng lõi public/d05-core.js), nên người đã đăng nhập được ghi 4 collection này.
    match /d05Daily/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /d05Days/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /d05ItemStores/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /syncState/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Phiếu CSKH nạp tay từ file Export Ticket (trang Customer Service)
    match /csTickets/{ticketId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Phần còn lại (histDays, histMonths...): chỉ đọc, không ai ghi từ trình duyệt -
    // chỉ script dùng Admin SDK (service account) ghi, luôn bỏ qua rules này.
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
